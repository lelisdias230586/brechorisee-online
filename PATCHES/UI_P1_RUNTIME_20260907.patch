+/*
+ * BRECHORISEE Admin Products — mobile safety layer
+ * Scope intentionally limited to the administrative catalogue.
+ */
+
+.brm-admin-head,
+.brm-admin-server-search,
+.brm-admin-marketplace,
+.brm-admin-marketplace * {
+  box-sizing: border-box;
+  min-width: 0;
+}
+
+.brm-admin-server-search .search-row > * {
+  min-width: 0;
+}
+
+.brm-admin-marketplace .brm-toolbar,
+.brm-admin-marketplace .brm-search,
+.brm-admin-marketplace .brm-tabs,
+.brm-admin-marketplace .brm-result-row {
+  max-width: 100%;
+}
+
+@media (max-width: 820px) {
+  .brm-admin-head {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr);
+    gap: 12px;
+    align-items: start;
+  }
+
+  .brm-admin-head .btn,
+  .brm-admin-head > a.btn {
+    width: 100%;
+    justify-content: center;
+  }
+
+  .brm-admin-server-search .search-row {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr);
+    gap: 10px;
+    width: 100%;
+  }
+
+  .brm-admin-server-search .quick-input-wrap,
+  .brm-admin-server-search input,
+  .brm-admin-server-search select,
+  .brm-admin-server-search button {
+    width: 100%;
+    max-width: 100%;
+  }
+
+  .brm-admin-marketplace .brm-toolbar {
+    position: relative;
+    top: auto;
+    overflow: visible;
+    padding: 12px 0 8px;
+  }
+
+  .brm-admin-marketplace .brm-search {
+    display: grid;
+    grid-template-columns: 30px minmax(0, 1fr) 46px;
+    gap: 8px;
+    align-items: center;
+    width: 100%;
+    overflow: visible;
+  }
+
+  .brm-admin-marketplace .brm-search > span:first-child {
+    width: 30px;
+    display: grid;
+    place-items: center;
+  }
+
+  .brm-admin-marketplace .brm-search > .quick-input-wrap {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) 38px;
+    width: 100%;
+    min-width: 0;
+  }
+
+  .brm-admin-marketplace .brm-search > .quick-input-wrap > input {
+    width: 100%;
+    min-width: 0;
+  }
+
+  .brm-admin-marketplace .brm-search .voice-input-btn {
+    width: 38px;
+    min-width: 38px;
+    padding-left: 0;
+    padding-right: 0;
+  }
+
+  .brm-admin-marketplace .brm-filter-button {
+    width: 46px;
+    min-width: 46px;
+    padding: 9px 7px;
+    justify-content: center;
+  }
+
+  .brm-admin-marketplace .brm-filter-button span:last-child {
+    display: none;
+  }
+
+  .brm-admin-marketplace .brm-tabs {
+    display: flex;
+    flex-wrap: nowrap;
+    gap: 8px;
+    width: 100%;
+    overflow-x: auto;
+    overflow-y: hidden;
+    -webkit-overflow-scrolling: touch;
+    scrollbar-width: thin;
+    padding: 4px 1px 8px;
+    scroll-padding-inline: 1px;
+  }
+
+  .brm-admin-marketplace .brm-tabs > button,
+  .brm-admin-marketplace .brm-tabs > a {
+    flex: 0 0 auto;
+    white-space: nowrap;
+  }
+
+  .brm-admin-marketplace .brm-result-row {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 7px 12px;
+    align-items: center;
+  }
+
+  .brm-admin-marketplace .brm-result-row > * {
+    max-width: 100%;
+    overflow-wrap: anywhere;
+  }
+
+  .brm-admin-grid .brm-media {
+    aspect-ratio: 4 / 5;
+    height: auto;
+    overflow: hidden;
+  }
+
+  .brm-admin-grid .brm-media img,
+  .brm-admin-grid .brm-carousel-slide {
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+    object-position: center top;
+  }
+
+  .brm-admin-grid .brm-admin-actions {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 8px;
+  }
+
+  .brm-admin-grid .brm-admin-actions > * {
+    width: 100%;
+    min-width: 0;
+    text-align: center;
+    justify-content: center;
+    overflow-wrap: anywhere;
+  }
+
+  .brm-admin-grid .brm-admin-actions .brm-share,
+  .brm-admin-grid .brm-admin-actions > :nth-child(3) {
+    grid-column: 1 / -1;
+  }
+}
+
+@media (max-width: 380px) {
+  .brm-admin-marketplace .brm-search {
+    grid-template-columns: 28px minmax(0, 1fr) 42px;
+    gap: 6px;
+  }
+
+  .brm-admin-marketplace .brm-filter-button {
+    width: 42px;
+    min-width: 42px;
+  }
+
+  .brm-admin-marketplace .brm-search > .quick-input-wrap {
+    grid-template-columns: minmax(0, 1fr) 36px;
+  }
+
+  .brm-admin-marketplace .brm-search .voice-input-btn {
+    width: 36px;
+    min-width: 36px;
+  }
+}
